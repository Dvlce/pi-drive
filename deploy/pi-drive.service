[Unit]
Description=Pi Drive - Archivio Wi-Fi
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
User=dvlce
Group=dvlce
EnvironmentFile=/etc/pi-drive.env
WorkingDirectory=/opt/pi-drive/server
ExecStart=/usr/bin/python3 /opt/pi-drive/server/app.py --host 0.0.0.0 --port 8090
Restart=on-failure
RestartSec=5
PrivateTmp=true
ProtectSystem=full
UMask=0077

[Install]
WantedBy=multi-user.target
